GREEN="\033[0;32m"
RED="\033[0;31m"
CYAN="\033[0;36m"
MAGENTA="\033[1;35m"
RESET="\033[0m"

echo "${MAGENTA}Running pre-push checks...${RESET}"

echo "${CYAN}Checking formatting...${RESET}"
bun run format:check || { echo "${RED}Formatting failed. Run: bun run format${RESET}"; exit 1; }

echo "${CYAN}Running linter...${RESET}"
bun run lint || { echo "${RED}Linting failed${RESET}"; exit 1; }

echo "${CYAN}Parsing daemon and extension...${RESET}"
bun run check-syntax || { echo "${RED}Syntax check failed${RESET}"; exit 1; }

echo "${GREEN}All pre-push checks passed${RESET}"
